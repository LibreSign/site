{
    "name": "libresign/libresign-www",
    "description": "LibreSign Website",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.3",
        "tightenco/jigsaw": "^1.7",
        "gregwar/captcha": "^2.1",
        "libresign/espeak": "dev-main",
        "nesbot/carbon": "^3.3",
        "samdark/sitemap": "^3.0",
        "libresign/jigsaw-localization": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "mikey179/vfsstream": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\Listeners\\": "listeners",
            "App\\Support\\": "support/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "npm ci"
        ],
        "extract-strings": [
            "JIGSAW_EXTRACT_STRINGS=1 ./vendor/bin/jigsaw build local"
        ],
        "dev": [
            "npm run watch"
        ],
        "test": [
            "vendor/bin/phpunit --colors=always"
        ],
        "prod": [
            "npm run prod"
        ],
        "validate-translations": "php scripts/validate-translations.php"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/LibreSign/jigsaw-localization"
        }
    ],
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}
